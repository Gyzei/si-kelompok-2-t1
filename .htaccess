Options -Indexes
DirectoryIndex index.php index.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:work|scripts|tests|data|server|supabase|api|node_modules|\.git|\.github)/ - [F,L]
RewriteRule ^(?:\.env(?:\..*)?|package(?:-lock)?\.json|vercel\.json|kumpulkan\.(?:ps1|cmd)|README\.md|SETUP-SUPABASE\.md|\.gitignore|\.vercelignore|data/\.collect\.lock)$ - [F,L]
</IfModule>
<FilesMatch "^\.env(?:\.|$)">
Require all denied
</FilesMatch>
