Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:work|outputs|scripts|tests|server|supabase|api|node_modules|\.git|\.github)/ - [F,L]
RewriteRule ^(?:\.env(?:\..*)?|package(?:-lock)?\.json|vercel\.json|README\.md|SETUP-SUPABASE\.md|\.gitignore|\.vercelignore)$ - [F,L]
</IfModule>
<FilesMatch "^\.env(?:\.|$)">
Require all denied
</FilesMatch>
