# Server only. Never use these names with a NEXT_PUBLIC_ / VITE_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Legacy service_role JWT also works via SUPABASE_SERVICE_ROLE_KEY.
